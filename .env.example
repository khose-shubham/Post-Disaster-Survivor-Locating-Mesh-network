# ==============================================================================
# TRACE Production Environment Configuration
# Copy this file to .env before starting the server:
#   cp .env.example .env
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Database Configuration
# Default: Embedded SQLite in WAL mode with foreign keys enabled
DATABASE_PATH=./data/trace.db

# Optional: Remote PostgreSQL connection string (when deploying with Postgres/PostGIS)
# DATABASE_URL=postgres://trace_user:secret_password@localhost:5432/trace_db

# Security & Authentication
# Secret key used for session signing and HMAC validation (min 32 characters)
SESSION_SECRET=replace_with_a_secure_random_string_min_32_chars

# Cookie Security (set to true in HTTPS production deployments)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Hardware Gateway Ingress Credentials
GATEWAY_DEFAULT_SECRET=gw-secret-primary-alpha

# Rate Limiting Parameters
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=60
